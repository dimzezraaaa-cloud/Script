local function applyIcon(img, name)
	local data = resolveIcon(name)
	if not data then return false end
	img.Image = data.image
	if data.size then img.ImageRectSize = data.size end
	if data.pos then img.ImageRectOffset = data.pos end
	return true
end

local function makeIcon(parent, name, size, color)
	local img = Instance.new("ImageLabel")
	img.BackgroundTransparency = 1
	img.AnchorPoint = Vector2.new(0.5, 0.5)
	img.Position = UDim2.new(0.5, 0, 0.5, 0)
	img.Size = UDim2.new(0, size, 0, size)
	img.ImageColor3 = color
	img.Parent = parent

	if applyIcon(img, name) then return img end

	img:Destroy()
	local lbl = Instance.new("TextLabel")
	lbl.BackgroundTransparency = 1
	lbl.AnchorPoint = Vector2.new(0.5, 0.5)
	lbl.Position = UDim2.new(0.5, 0, 0.5, 0)
	lbl.Size = UDim2.new(1, 0, 1, 0)
	lbl.Font = Enum.Font.GothamBold
	lbl.TextSize = 11
	lbl.Text = FALLBACK[name] or name
	lbl.TextColor3 = color
	lbl.Parent = parent
	return lbl
end

local function setIcon(icon, name)
	if icon:IsA("TextLabel") then
		icon.Text = FALLBACK[name] or name
	else
		applyIcon(icon, name)
	end
end

local function setIconColor(icon, color)
	if icon:IsA("TextLabel") then
		icon.TextColor3 = color
	else
		icon.ImageColor3 = color
	end
end

local function getFriends()
	local list = {}
	local ok, pages = pcall(function()
		return Players:GetFriendsAsync(player.UserId)
	end)
	if not ok then return list end
	while true do
		for _, item in ipairs(pages:GetCurrentPage()) do
			table.insert(list, item)
		end
		if pages.IsFinished then break end
		local adv = pcall(function()
			pages:AdvanceToNextPageAsync()
		end)
		if not adv then break end
	end
	table.sort(list, function(a, b)
		return string.lower(a.Username or "") < string.lower(b.Username or "")
	end)
	return list
end

local function isDeletedAccount(friend)
	local u = string.lower(friend.Username or "")
	local d = string.lower(friend.DisplayName or "")
	if u == "" then return true end
	if string.find(u, "^deleted") then return true end
	if string.find(d, "account deleted", 1, true) then return true end
	return false
end

local function fetchPresence()
	local map = {}
	local ok, res = pcall(function()
		return player:GetFriendsOnline(200)
	end)
	if ok and type(res) == "table" then
		for _, f in ipairs(res) do
			local uid = f.VisitorId or f.UserId
			if uid then
				local lt = f.LocationType
				if lt == 1 or lt == 4 or lt == 5 then
					map[uid] = 2
				else
					map[uid] = 1
				end
			end
		end
	end
	return map
end

-- Cadangan: cek ID lewat HTTP request
local function lookupViaHttp(ids)
	if not httpRequest then return false, {} end
	local ok, res = pcall(function()
		return httpRequest({
			Url = "https://users.roproxy.com/v1/users",
			Method = "POST",
			Headers = { ["Content-Type"] = "application/json" },
			Body = HttpService:JSONEncode({ userIds = ids, excludeBannedUsers = true }),
		})
	end)
	if not ok or not res or res.StatusCode ~= 200 then return false, {} end

	local okJ, decoded = pcall(function()
		return HttpService:JSONDecode(res.Body)
	end)
	if not okJ or type(decoded) ~= "table" or type(decoded.data) ~= "table" then
		return false, {}
	end

	local valid = {}
	for _, u in ipairs(decoded.data) do
		local data = { Id = u.id, Username = u.name, DisplayName = u.displayName }
		if data.Id and not isDeletedAccount(data) then
			table.insert(valid, data)
		end
	end
	return true, valid
end

-- Cek banyak ID sekaligus. Return ok, list akun valid saja
local function fetchValidUsers(ids)
	local ok, res = pcall(function()
		return UserService:GetUserInfosByUserIdsAsync(ids)
	end)
	if ok and type(res) == "table" then
		local valid = {}
		for _, info in ipairs(res) do
			local data = { Id = info.Id, Username = info.Username, DisplayName = info.DisplayName }
			if data.Id and not isDeletedAccount(data) then
				table.insert(valid, data)
			end
		end
		return true, valid
	end
	return lookupViaHttp(ids)
end

local function copyToClipboard(text)
	local fn = setclipboard or toclipboard or (syn and syn.write_clipboard)
	if fn then
		return pcall(fn, text)
	end
	return false
end

