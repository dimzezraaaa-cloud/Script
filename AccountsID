local function applyFilter(view)
	local q = string.lower(searchBox.Text)
	local shown = 0
	for _, r in ipairs(view.rows) do
		local vis = (q == "") or (string.find(r.key, q, 1, true) ~= nil)
		r.frame.Visible = vis
		if vis then shown += 1 end
	end
	if #view.rows == 0 then
		view.status.Text = view.loaded and view.empty or view.status.Text
		view.status.Visible = true
	elseif shown == 0 then
		view.status.Text = "No results"
		view.status.Visible = true
	else
		view.status.Visible = false
	end
end

local function updateRowState(r, state)
	if r.fixed ~= nil then state = r.fixed end
	r.state = state
	if r.deleted then
		r.frame.LayoutOrder = r.flat and r.alpha or (DELETED_RANK * RANK_STEP + r.alpha)
		return
	end
	tween(r.dot, FAST, { BackgroundColor3 = STATUS_COLOR[state] or STATUS_COLOR[0] })
	if r.flat then
		r.frame.LayoutOrder = r.alpha
	else
		r.frame.LayoutOrder = (STATE_RANK[state] or 3) * RANK_STEP + r.alpha
	end
end

