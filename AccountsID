			task.spawn(lookupQuery, text, true)
		end
	end
end)

local function selectTab(which)
	local isAll = which == "all"
	activeView = isAll and allView or friendsView
	friendsView.scroll.Visible = not isAll
	allView.scroll.Visible = isAll
	searchBox.PlaceholderText = isAll and "Filter list, or type exact username/ID" or "Search name, username, or ID"

	for key, b in pairs(tabButtons) do
		local on = key == which
		tween(b, FAST, {
			BackgroundTransparency = on and 0 or 1,
			TextColor3 = on and T.onAccent or T.dim,
		})
	end

	if isAll and not allStarted then
		allStarted = true
		runAllWorker()
	end
	applyFilter(activeView)
	updateCount()
end

