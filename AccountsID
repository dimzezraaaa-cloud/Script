-- ===== TAB ALL (ID acak, hanya akun valid) =====
local allStarted = false
local allSeq = 0
local lookupSeq = 0
local seen = {}   -- ID yang sudah dicek / sudah tampil
local pool = {}   -- akun valid yang menunggu giliran tampil
local alive = true

local function addAllRow(data, alpha)
	local inServer = Players:GetPlayerByUserId(data.Id) ~= nil
	local state = inServer and 2 or 0
	addRow(allView, data, alpha, state, state, true)
	allView.loaded = true
	applyFilter(allView)
	if activeView == allView then updateCount() end
end

local function refillPool()
	local ids = {}
	local picked = {}
	while #ids < BATCH do
		local id = rng:NextInteger(MIN_ID, MAX_ID)
		if not seen[id] and not picked[id] then
			picked[id] = true
			table.insert(ids, id)
		end
	end

	local ok, valid = fetchValidUsers(ids)
	if not ok then
		return false -- throttle / error
	end

	for _, id in ipairs(ids) do
		seen[id] = true
	end
	for _, data in ipairs(valid) do
		table.insert(pool, data)
	end
	return true
end

local function runAllWorker()
	task.spawn(function()
		while alive and gui.Parent do
			if activeView ~= allView then
				task.wait(0.5) -- pause saat tab Friends aktif
			elseif #allView.rows >= MAX_ROWS then
				allView.loaded = true
				applyFilter(allView)
				task.wait(1)
			elseif #pool == 0 then
				if refillPool() then
					task.wait(0.2)
				else
					if #allView.rows == 0 then
						allView.status.Text = "Request gagal, mencoba lagi"
						allView.status.Visible = true
					end
					task.wait(2)
				end
			else
				local data = table.remove(pool, 1)
				allSeq += 1
				addAllRow(data, allSeq)
				task.wait(LOAD_DELAY)
			end
		end
	end)
end

-- ===== CARI LANGSUNG KE ROBLOX (username / ID) =====
local function lookupId(id)
	for _, r in ipairs(allView.rows) do
		if r.id == id then
			allView.scroll.CanvasPosition = Vector2.new(0, 0)
			toast("Sudah ada di list")
			return
		end
	end
	local ok, valid = fetchValidUsers({ id })
	if not ok then
		toast("Gagal cek, coba lagi")
		return
	end
	if #valid == 0 then
		toast("ID tidak valid")
		return
	end
	seen[id] = true
	lookupSeq += 1
	addAllRow(valid[1], -lookupSeq)
	allView.scroll.CanvasPosition = Vector2.new(0, 0)
	toast("Akun ditemukan")
end

-- Username -> ID
local function resolveUsername(name)
	local ok, id = pcall(function()
		return Players:GetUserIdFromNameAsync(name)
	end)
	if ok and id then return id end

	if httpRequest then
		local ok2, res = pcall(function()
			return httpRequest({
				Url = "https://users.roproxy.com/v1/usernames/users",
				Method = "POST",
				Headers = { ["Content-Type"] = "application/json" },
				Body = HttpService:JSONEncode({ usernames = { name }, excludeBannedUsers = true }),
			})
		end)
		if ok2 and res and res.StatusCode == 200 then
			local okJ, dec = pcall(function()
				return HttpService:JSONDecode(res.Body)
			end)
			if okJ and type(dec) == "table" and type(dec.data) == "table" and dec.data[1] then
				return dec.data[1].id
			end
		end
	end
	return nil
end

local tried = {} -- query yang sudah dicari, supaya tidak diulang terus

local function lookupQuery(text, force)
	local q = string.lower(text)
	if not force and tried[q] then return end
	tried[q] = true

	local num = tonumber(q)
	if num and num >= 1 and num == math.floor(num) then
		toast("Mencari ID...")
		lookupId(num)
		return
	end

	if not string.match(text, "^[%w_]+$") or #text < 3 or #text > 20 then
		toast("Username tidak valid")
		return
	end

	toast("Mencari di Roblox...")
	local id = resolveUsername(text)
	if not id then
		toast("Username tidak ditemukan")
		return
	end
	lookupId(id)
end

local function hasVisibleRow()
	for _, r in ipairs(allView.rows) do
		if r.frame.Visible then return true end
	end
	return false
end

