local function resolveIcon(name)
	if not lucide then return nil end
	local ok, res = pcall(function()
		return lucide.Icon(name, "lucide")
	end)
	if not ok or res == nil then
		ok, res = pcall(function()
			return lucide.Icon(name)
		end)
	end
	if not ok or res == nil then return nil end

	if type(res) == "string" then
		return { image = res }
	end
	if type(res) == "table" then
		local meta = res[2] or res
		local img = res[1] or res.Image or (type(meta) == "table" and meta.Image)
		if img then
			return {
				image = img,
				size = meta.ImageRectSize,
				pos = meta.ImageRectPosition or meta.ImagePosition,
			}
		end
	end
	return nil
end

