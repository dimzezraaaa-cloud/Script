-- OPEN / CLOSE ANIMATION ---------------------------------------------------------
local isOpen = false
local token = 0

local function setOpen(open)
	isOpen = open
	token = token + 1
	local my = token

	if open then
		panel.Visible = true
		panel.GroupTransparency = 1
		panelScale.Scale = 0.92
		panel.Position = UDim2.fromOffset(panelX, panelY - 14)
		tween(panel, SMOOTH, {
			GroupTransparency = 0,
			Position = UDim2.fromOffset(panelX, panelY),
		})
		tween(panelScale, SMOOTH, { Scale = 1 })
	else
		tween(panel, SMOOTH_IN, {
			GroupTransparency = 1,
			Position = UDim2.fromOffset(panelX, panelY - 14),
		})
		local t = tween(panelScale, SMOOTH_IN, { Scale = 0.92 })
		t.Completed:Connect(function()
			if my == token then
				panel.Visible = false
			end
		end)
	end
end

openBtn.Activated:Connect(function()
	setOpen(not isOpen)
end)
closeBtn.Activated:Connect(function()
	setOpen(false)
end)

-- DRAGGING (title bar) ------------------------------------------------------------
local dragging = false
local dragStart = nil
local startX, startY = 0, 0

titleBar.InputBegan:Connect(function(input)
	if input.UserInputType == Enum.UserInputType.MouseButton1
		or input.UserInputType == Enum.UserInputType.Touch then
		dragging = true
		dragStart = input.Position
		startX, startY = panelX, panelY
		input.Changed:Connect(function()
			if input.UserInputState == Enum.UserInputState.End then
				dragging = false
			end
		end)
	end
end)

UserInputService.InputChanged:Connect(function(input)
	if dragging and (input.UserInputType == Enum.UserInputType.MouseMovement
		or input.UserInputType == Enum.UserInputType.Touch) then
		local delta = input.Position - dragStart
		local cam = workspace.CurrentCamera
		local v = cam and cam.ViewportSize or Vector2.new(800, 400)
		local nx = math.clamp(startX + delta.X, PANEL_W / 2, v.X - PANEL_W / 2)
		local ny = math.clamp(startY + delta.Y, PANEL_H / 2, v.Y - PANEL_H / 2)
		panelX, panelY = nx, ny
		panel.Position = UDim2.fromOffset(nx, ny)
	end
end)

-- INSERT ACTIONS -----------------------------------------------------------------------
local inserted = {}
local currentSound = nil
local currentSoundId = nil

local function stopSound()
	if currentSound then
		pcall(function() currentSound:Destroy() end)
	end
	currentSound = nil
	currentSoundId = nil
end

local function spawnCFrame()
	local char = player.Character
	local root = char and char:FindFirstChild("HumanoidRootPart")
	if root then
		return root.CFrame * CFrame.new(0, 0, -8)
	end
	local cam = workspace.CurrentCamera
	if cam then
		return cam.CFrame * CFrame.new(0, 0, -10)
	end
	return CFrame.new(0, 10, 0)
end

local function loadAsset(id)
	local ok, objs = pcall(function()
		return game:GetObjects("rbxassetid://" .. tostring(id))
	end)
	if ok and type(objs) == "table" and objs[1] then
		return objs
	end
	local ok2, model = pcall(function()
		return InsertService:LoadAsset(id)
	end)
	if ok2 and model then
		return { model }
	end
	return nil
end

local function insertModel(id)
	local objs = loadAsset(id)
	if not objs then return false, "Failed to load asset" end

	local target = spawnCFrame()
	local count = 0
	for _, obj in ipairs(objs) do
		pcall(function()
			if obj:IsA("Model") then
				obj:PivotTo(target)
			elseif obj:IsA("BasePart") then
				obj.CFrame = target
			end
		end)
		obj.Parent = workspace
		table.insert(inserted, obj)
		count = count + 1
	end
	return true, "Inserted in front of you"
end

local function insertDecal(id)
	local part = create("Part", {
		Name = "LarperDecal",
		Anchored = true,
		CanCollide = false,
		Size = Vector3.new(5, 5, 0.2),
		CFrame = spawnCFrame(),
		Material = Enum.Material.SmoothPlastic,
		Color = Color3.new(1, 1, 1),
	}, workspace)
	create("Decal", {
		Texture = "rbxassetid://" .. tostring(id),
		Face = Enum.NormalId.Front,
	}, part)
	create("Decal", {
		Texture = "rbxassetid://" .. tostring(id),
		Face = Enum.NormalId.Back,
	}, part)
	table.insert(inserted, part)
	return true, "Decal placed in front of you"
end

local function toggleAudio(id)
	if currentSound and currentSoundId == id then
		stopSound()
		return true, "Audio stopped"
	end
	stopSound()
	local sound = create("Sound", {
		Name = "LarperAudio",
		SoundId = "rbxassetid://" .. tostring(id),
		Volume = 1,
		Looped = false,
	}, SoundService)
	currentSound = sound
	currentSoundId = id
	sound:Play()
	sound.Ended:Connect(function()
		if currentSound == sound then
			stopSound()
		end
	end)
	return true, "Playing audio (tap again to stop)"
end

local function applyItem(cat, item)
	if cat.Kind == "model" then
		return insertModel(item.Id)
	elseif cat.Kind == "decal" then
		return insertDecal(item.Id)
	elseif cat.Kind == "audio" then
		return toggleAudio(item.Id)
	end
	return false, "Unsupported category"
end

clearBtn.Activated:Connect(function()
	stopSound()
	local n = 0
	for _, obj in ipairs(inserted) do
		pcall(function() obj:Destroy() end)
		n = n + 1
	end
	inserted = {}
	if n > 0 then
		setStatus("Removed " .. n .. " inserted item(s)", "ok")
	else
		setStatus("Nothing to clear")
	end
end)

-- HTTP + SEARCH ---------------------------------------------------------------------------
local httpFn = (syn and syn.request) or (http and http.request) or http_request or request
	or (fluxus and fluxus.request)

local catIndex = 1
local sortIndex = 1
local nextToken = nil
local finished = true
local seen = {}
local count = 0
local loading = false

local function clearGrid()
