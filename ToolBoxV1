	card.Activated:Connect(function()
		setStatus("Working...")
		local ok, msg = applyItem(cat, item)
		setStatus(msg, ok and "ok" or "warn")
	end)
end

local function searchRequest(cat, pageToken)
	if not httpFn then
		return nil, "This executor has no HTTP request function"
	end

	local body = {
		searchCategoryType = cat.Type,
		maxPageSize = PAGE_SIZE,
		sortCategory = SORTS[sortIndex],
		searchView = "Full",
	}
	if searchBox.Text ~= "" then
		body.query = searchBox.Text
	end
	if pageToken then
		body.pageToken = pageToken
	end

	local ok, res = pcall(function()
		return httpFn({
			Url = SEARCH_URL,
			Method = "POST",
			Headers = {
				["x-api-key"] = API_KEY,
				["Content-Type"] = "application/json",
			},
			Body = HttpService:JSONEncode(body),
		})
	end)
	if not ok or not res then
		return nil, "Request failed: " .. tostring(res)
	end

	local code = res.StatusCode or 0
	if code == 401 or code == 403 then
		return nil, "API key rejected (" .. code .. "). Check the key and its scopes."
	elseif code == 429 then
		return nil, "Rate limited (429). Wait a moment and retry."
	elseif code < 200 or code >= 300 then
		return nil, "HTTP " .. tostring(code)
	end

	local okJ, data = pcall(function()
		return HttpService:JSONDecode(res.Body)
	end)
	if not okJ or type(data) ~= "table" then
		return nil, "Could not read the response"
	end
	return data
end

local function readAssets(data, cat)
	local list = data.creatorStoreAssets
	if type(list) ~= "table" then return end
	for _, entry in ipairs(list) do
		local a = entry.asset
		if type(a) == "table" and a.id then
			addCard({ Id = tonumber(a.id), Name = a.name }, cat)
		end
	end
	nextToken = data.nextPageToken
	if nextToken == nil or nextToken == "" then
		finished = true
		nextToken = nil
	else
		finished = false
	end
end

local function updateStatus()
	setStatus("Loaded: " .. count .. (finished and " (end of results)" or " (more available)"))
	moreBtn.Text = finished and "End" or "Load More"
end

local function loadMore()
	if loading or finished or not nextToken then return end
	loading = true
	setStatus("Loading next page...")
	local cat = CATEGORIES[catIndex]
	local data, err = searchRequest(cat, nextToken)
	if data then
		readAssets(data, cat)
		updateStatus()
	else
		setStatus(err, "warn")
	end
	loading = false
end

local function startSearch()
	if loading then return end
	loading = true
	setStatus("Searching...")
	clearGrid()
	seen = {}
	count = 0
	nextToken = nil
	finished = true

	local cat = CATEGORIES[catIndex]
	local data, err = searchRequest(cat, nil)
	if not data then
		setStatus(err, "warn")
		loading = false
		return
	end

	readAssets(data, cat)
	if count == 0 then
		setStatus("No results", "warn")
		moreBtn.Text = "End"
	else
		updateStatus()
	end
	loading = false
end

