            Click.Text = ""
            Click.ZIndex = 7
            Click.Parent = Row
            Click.MouseButton1Click:Connect(function()
                val = not val
                upd()
                pcall(ripple, Row)
                if o.Callback then pcall(o.Callback, val) end
            end)

            local obj = {}
            function obj:Set(v) val = v; upd() end
            function obj:Get() return val end
            return obj
        end

        function Tab:CreateSlider(o)
            o = o or {}
            local mn  = o.Min     or 0
            local mx  = o.Max     or 100
            local val = o.Default or mn

            local Row = Instance.new("Frame")
            Row.BackgroundColor3 = C.element
            Row.Size = UDim2.new(1,-24,0,58)
            Row.ZIndex = 4
            mkCorner(Row, 8)
            mkStroke(Row)
            Row.Parent = Page

