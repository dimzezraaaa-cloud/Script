            DList.ZIndex = 16
            DList.Parent = DDFrame
            mkList(DList, nil, 2)
            mkPadding(DList, 4)

            for _, item in ipairs(items) do
                local IBtn = Instance.new("TextButton")
                IBtn.BackgroundTransparency = 1
                IBtn.BackgroundColor3 = C.element2
                IBtn.Size = UDim2.new(1,-8,0,32)
                IBtn.Font = Enum.Font.Gotham
                IBtn.Text = item
                IBtn.TextColor3 = C.text
                IBtn.TextSize = 13
                IBtn.ZIndex = 17
                mkCorner(IBtn, 6)
                IBtn.Parent = DList
                IBtn.MouseEnter:Connect(function() tween(IBtn, {BackgroundTransparency = 0.7}, 0.1) end)
                IBtn.MouseLeave:Connect(function() tween(IBtn, {BackgroundTransparency = 1}, 0.1) end)
                IBtn.MouseButton1Click:Connect(function()
                    current = item
                    SelLbl.Text = item
                    isOpen = false
                    tween(DDFrame, {Size = UDim2.new(1,0,0,0)}, 0.2)
                    tween(Arrow, {Rotation = 0}, 0.2)
                    if o.Callback then pcall(o.Callback, item) end
                end)
            end

            Box.MouseButton1Click:Connect(function()
                isOpen = not isOpen
                local h = isOpen and (#items * 36 + 8) or 0
                tween(DDFrame, {Size = UDim2.new(1,0,0,h)}, 0.2)
                tween(Arrow, {Rotation = isOpen and 180 or 0}, 0.2)
            end)

            local obj = {}
            function obj:Get() return current end
            function obj:Set(v) current = v; SelLbl.Text = v end
            return obj
        end

        function Tab:CreateInput(o)
            o = o or {}

            local Row = Instance.new("Frame")
            Row.BackgroundColor3 = C.element
            Row.Size = UDim2.new(1,-24,0,56)
            Row.ZIndex = 4
            mkCorner(Row, 8)
            mkStroke(Row)
            Row.Parent = Page

            local Lbl = Instance.new("TextLabel")
            Lbl.BackgroundTransparency = 1
            Lbl.Position = UDim2.fromOffset(14,8)
            Lbl.Size = UDim2.new(1,-28,0,16)
            Lbl.Font = Enum.Font.Gotham
            Lbl.Text = o.Name or "Input"
            Lbl.TextColor3 = C.subtext
            Lbl.TextSize = 11
            Lbl.TextXAlignment = Enum.TextXAlignment.Left
            Lbl.ZIndex = 5
            Lbl.Parent = Row

            local Box = Instance.new("TextBox")
            Box.BackgroundTransparency = 1
            Box.Position = UDim2.fromOffset(14,26)
            Box.Size = UDim2.new(1,-28,0,22)
            Box.Font = Enum.Font.GothamSemibold
            Box.PlaceholderText = o.Placeholder or "Ketik di sini..."
            Box.PlaceholderColor3 = C.border
            Box.Text = o.Default or ""
            Box.TextColor3 = C.text
            Box.TextSize = 13
            Box.TextXAlignment = Enum.TextXAlignment.Left
            Box.ClearTextOnFocus = false
            Box.ZIndex = 5
            Box.Parent = Row

            Box.FocusLost:Connect(function(enter)
                if o.Callback then pcall(o.Callback, Box.Text, enter) end
            end)

            return Box
        end

        return Tab
    end

    return Win
end

return NovaLibs