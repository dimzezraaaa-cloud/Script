local C    = Core.C

local Tab = {}

function Tab.new(win, opts)
    opts = opts or {}
    local name = opts.Name or "Tab"
    local icon = opts.Icon or ""

    local TabBtn = Instance.new("TextButton")
    TabBtn.BackgroundColor3 = C.sidebar
    TabBtn.BackgroundTransparency = 1
    TabBtn.Size = UDim2.new(1,-12,0,36)
    TabBtn.Font = Enum.Font.Gotham
    TabBtn.Text = (icon ~= "" and icon.."  " or "") .. name
    TabBtn.TextColor3 = C.subtext
    TabBtn.TextSize = 13
    TabBtn.TextXAlignment = Enum.TextXAlignment.Left
    TabBtn.ZIndex = 5
    Core.corner(TabBtn, 8)
    Core.padding(TabBtn, 10)
    TabBtn.Parent = win._sidebar

    local AccBar = Instance.new("Frame")
    AccBar.BackgroundColor3 = C.accent
    AccBar.Size = UDim2.fromOffset(3,20)
    AccBar.AnchorPoint = Vector2.new(0,0.5)
    AccBar.Position = UDim2.new(0,0,0.5,0)
    AccBar.Visible = false
    AccBar.ZIndex = 6
    Core.corner(AccBar, 2)
    AccBar.Parent = TabBtn

    local Page = Instance.new("ScrollingFrame")
    Page.BackgroundTransparency = 1
    Page.Size = UDim2.new(1,0,1,0)
    Page.ScrollBarThickness = 2
    Page.ScrollBarImageColor3 = C.accent
    Page.CanvasSize = UDim2.new(0,0,0,0)
    Page.AutomaticCanvasSize = Enum.AutomaticSize.Y
    Page.Visible = false
    Page.ZIndex = 3
    Page.Parent = win._content
    Core.list(Page, nil, 8)
    Core.padding(Page, 12)

    local self = {_btn = TabBtn, _acc = AccBar, _page = Page, _win = win, _core = Core}

    local function activate()
        if win._active and win._active ~= self then
            Core.tween(win._active._btn, {BackgroundTransparency = 1, TextColor3 = C.subtext}, 0.15)
            win._active._acc.Visible = false
            win._active._page.Visible = false
        end
        win._active = self
        Core.tween(TabBtn, {BackgroundTransparency = 0.85, TextColor3 = C.text}, 0.15)
        AccBar.Visible = true
        Page.Visible = true
        Core.ripple(TabBtn)
    end

    TabBtn.MouseButton1Click:Connect(activate)
    if #win._tabs == 0 then activate() end
    table.insert(win._tabs, self)

    return self
end

return Tab

