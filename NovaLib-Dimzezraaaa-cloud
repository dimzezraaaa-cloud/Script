    local Lbl = Instance.new("TextLabel")
    Lbl.BackgroundTransparency = 1
    Lbl.Position = UDim2.fromOffset(14,10)
    Lbl.Size = UDim2.new(1,-90,0,18)
    Lbl.Font = Enum.Font.Gotham
    Lbl.Text = o.Name or "Slider"
    Lbl.TextColor3 = C.text
    Lbl.TextSize = 13
    Lbl.TextXAlignment = Enum.TextXAlignment.Left
    Lbl.ZIndex = 5
    Lbl.Parent = Row

    local ValLbl = Instance.new("TextLabel")
    ValLbl.BackgroundTransparency = 1
    ValLbl.AnchorPoint = Vector2.new(1,0)
    ValLbl.Position = UDim2.new(1,-14,0,10)
    ValLbl.Size = UDim2.fromOffset(60,18)
    ValLbl.Font = Enum.Font.GothamBold
    ValLbl.Text = tostring(val)
    ValLbl.TextColor3 = C.accent
    ValLbl.TextSize = 13
    ValLbl.TextXAlignment = Enum.TextXAlignment.Right
    ValLbl.ZIndex = 5
    ValLbl.Parent = Row

    local Track = Instance.new("Frame")
    Track.BackgroundColor3 = C.border
    Track.Position = UDim2.new(0,14,1,-20)
    Track.Size = UDim2.new(1,-28,0,6)
    Track.ZIndex = 5
    Core.corner(Track, 3)
    Track.Parent = Row

    local Fill = Instance.new("Frame")
    Fill.BackgroundColor3 = C.accent
    Fill.Size = UDim2.fromScale((val-mn)/(mx-mn),1)
    Fill.ZIndex = 6
    Core.corner(Fill, 3)
    Fill.Parent = Track

    local Knob = Instance.new("Frame")
    Knob.BackgroundColor3 = Color3.new(1,1,1)
    Knob.AnchorPoint = Vector2.new(0.5,0.5)
    Knob.Position = UDim2.fromScale((val-mn)/(mx-mn),0.5)
    Knob.Size = UDim2.fromOffset(14,14)
    Knob.ZIndex = 7
    Core.corner(Knob, 7)
    Core.stroke(Knob, C.accent, 2)
    Knob.Parent = Track

    local drag = false
    local function upd(input)
        local rel = math.clamp((input.Position.X - Track.AbsolutePosition.X) / Track.AbsoluteSize.X, 0, 1)
        val = math.floor(mn + (mx-mn) * rel)
        ValLbl.Text = tostring(val)
        Core.tween(Fill, {Size = UDim2.fromScale(rel,1)}, 0.05)
        Core.tween(Knob, {Position = UDim2.fromScale(rel,0.5)}, 0.05)
        if o.Callback then pcall(o.Callback, val) end
    end

    Track.InputBegan:Connect(function(inp)
        if inp.UserInputType == Enum.UserInputType.MouseButton1 then drag = true; upd(inp) end
    end)
    UIS.InputChanged:Connect(function(inp)
        if drag and inp.UserInputType == Enum.UserInputType.MouseMovement then upd(inp) end
    end)
    UIS.InputEnded:Connect(function(inp)
        if inp.UserInputType == Enum.UserInputType.MouseButton1 then drag = false end
    end)

    local obj = {}
    function obj:Set(v)
        val = math.clamp(v,mn,mx)
        local rel = (val-mn)/(mx-mn)
        ValLbl.Text = tostring(val)
        Fill.Size = UDim2.fromScale(rel,1)
        Knob.Position = UDim2.fromScale(rel,0.5)
    end
    function obj:Get() return val end
    return obj
end

