function E.Input(page, o)
    o = o or {}

    local Row = Instance.new("Frame")
    Row.BackgroundColor3 = C.element
    Row.Size = UDim2.new(1,-24,0,56)
    Row.ZIndex = 4
    Core.corner(Row, 8)
    Core.stroke(Row)
    Row.Parent = page

    local Lbl = Instance.new("TextLabel")
    Lbl.BackgroundTransparency = 1
    Lbl.Position = UDim2.fromOffset(14,8)
    Lbl.Size = UDim2.new(1,-28,0,16)
    Lbl.Font = Enum.Font.Gotham
    Lbl.Text = o.Name or "Input"
    Lbl.TextColor3 = C.subtext
    Lbl.TextSize = 11
    Lbl.TextXAlignment = Enum.TextXAlignment.Left
    Lbl.ZIndex = 5
    Lbl.Parent = Row

    local Box = Instance.new("TextBox")
    Box.BackgroundTransparency = 1
    Box.Position = UDim2.fromOffset(14,26)
    Box.Size = UDim2.new(1,-28,0,22)
    Box.Font = Enum.Font.GothamSemibold
    Box.PlaceholderText = o.Placeholder or "Ketik di sini..."
    Box.PlaceholderColor3 = C.border
    Box.Text = o.Default or ""
    Box.TextColor3 = C.text
    Box.TextSize = 13
    Box.ClearTextOnFocus = false
    Box.ZIndex = 5
    Box.Parent = Row

    Box.FocusLost:Connect(function(enter)
        if o.Callback then pcall(o.Callback, Box.Text, enter) end
    end)
    return Box
end

return E

local NovaLibs = {}

function NovaLibs:CreateWindow(opts)
    local win = WinLib.new(opts)

    function win:CreateTab(tabOpts)
        local tab = TabLib.new(self, tabOpts)

        function tab:CreateSection(n)   ElemLib.Section(self._page, n)        end
        function tab:CreateButton(o)    return ElemLib.Button(self._page, o)  end
        function tab:CreateToggle(o)    return ElemLib.Toggle(self._page, o)  end
        function tab:CreateSlider(o)    return ElemLib.Slider(self._page, o)  end
        function tab:CreateDropdown(o)  return ElemLib.Dropdown(self._page, o)end
        function tab:CreateInput(o)     return ElemLib.Input(self._page, o)   end

        return tab
    end

    return win
end

return NovaLibs