-- OPEN / CLOSE ANIMATION --------------------------------------------------
local isOpen = false
local token = 0

local function setOpen(open)
	isOpen = open
	token = token + 1
	local my = token

	if open then
		panel.Visible = true
		panel.GroupTransparency = 1
		panelScale.Scale = 0.92
		panel.Position = UDim2.fromOffset(panelX, panelY - 14)
		tween(panel, SMOOTH, {
			GroupTransparency = 0,
			Position = UDim2.fromOffset(panelX, panelY),
		})
		tween(panelScale, SMOOTH, { Scale = 1 })
	else
		tween(panel, SMOOTH_IN, {
			GroupTransparency = 1,
			Position = UDim2.fromOffset(panelX, panelY - 14),
		})
		local t = tween(panelScale, SMOOTH_IN, { Scale = 0.92 })
		t.Completed:Connect(function()
			if my == token then
				panel.Visible = false
			end
		end)
	end
end

openBtn.Activated:Connect(function()
	setOpen(not isOpen)
end)
closeBtn.Activated:Connect(function()
	setOpen(false)
end)

local function showPicker(show)
	if show then
		picker.Visible = true
		picker.GroupTransparency = 1
		picker.Position = UDim2.fromOffset(10, 126)
		tween(picker, SMOOTH, {
			GroupTransparency = 0,
			Position = UDim2.fromOffset(10, 116),
		})
	else
		local t = tween(picker, SMOOTH_IN, {
			GroupTransparency = 1,
			Position = UDim2.fromOffset(10, 126),
		})
		t.Completed:Connect(function()
			if picker.GroupTransparency >= 0.99 then
				picker.Visible = false
			end
		end)
	end
end

backBtn.Activated:Connect(function()
	showPicker(false)
end)

-- DRAGGING (title bar) ------------------------------------------------------
local dragging = false
local dragStart = nil
local startX, startY = 0, 0

titleBar.InputBegan:Connect(function(input)
	if input.UserInputType == Enum.UserInputType.MouseButton1
		or input.UserInputType == Enum.UserInputType.Touch then
		dragging = true
		dragStart = input.Position
		startX, startY = panelX, panelY
		input.Changed:Connect(function()
			if input.UserInputState == Enum.UserInputState.End then
				dragging = false
			end
		end)
	end
end)

UserInputService.InputChanged:Connect(function(input)
	if dragging and (input.UserInputType == Enum.UserInputType.MouseMovement
		or input.UserInputType == Enum.UserInputType.Touch) then
		local delta = input.Position - dragStart
		local cam = workspace.CurrentCamera
		local v = cam and cam.ViewportSize or Vector2.new(800, 400)
		local nx = math.clamp(startX + delta.X, PANEL_W / 2, v.X - PANEL_W / 2)
		local ny = math.clamp(startY + delta.Y, PANEL_H / 2, v.Y - PANEL_H / 2)
		panelX, panelY = nx, ny
		panel.Position = UDim2.fromOffset(nx, ny)
	end
end)

