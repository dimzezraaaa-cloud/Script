-- LOCAL CHARACTER EDITING ---------------------------------------------------
local function remember(key, restoreFn)
	if not origs[key] then
		origs[key] = restoreFn
	end
end

local function loadAsset(id)
	local ok, objs = pcall(function()
		return game:GetObjects("rbxassetid://" .. tostring(id))
	end)
	if ok and type(objs) == "table" and objs[1] then
		return objs[1]
	end
	local ok2, model = pcall(function()
		return InsertService:LoadAsset(id)
	end)
	if ok2 and model then
		return model
	end
	return nil
end

local function hasAncestorNamed(inst, name)
	local p = inst.Parent
	while p do
		if p.Name == name then return true end
		p = p.Parent
	end
	return false
end

local function findPart(root, name)
	local fallback = nil
	for _, d in ipairs(root:GetDescendants()) do
		if d.Name == name and d:IsA("BasePart") then
			if hasAncestorNamed(d, "R15ArtistIntent") then
				return d
			end
			if not fallback then fallback = d end
		end
	end
	return fallback
end

local function findSource(loaded, partKey)
	for _, name in ipairs(PART_MESHES[partKey]) do
		local src = findPart(loaded, name)
		if src then return src end
	end
	return nil
end

local function textureOf(src)
	local sa = src:FindFirstChildOfClass("SurfaceAppearance")
	if sa and sa.ColorMap ~= "" then
		return sa.ColorMap
	end
	if src:IsA("MeshPart") and src.TextureID ~= "" then
		return src.TextureID
	end
	return ""
end

-- R15: swap mesh on MeshParts
local function swapMeshR15(target, src)
	if target:IsA("MeshPart") and src:IsA("MeshPart") then
		local m, t, s = target.MeshId, target.TextureID, target.Size
		local sa0 = target:FindFirstChildOfClass("SurfaceAppearance")
		local saCopy = sa0 and sa0:Clone() or nil
		remember("r15:" .. target.Name, function()
			pcall(function()
				target.MeshId = m
				target.TextureID = t
				target.Size = s
			end)
			for _, child in ipairs(target:GetChildren()) do
				if child:IsA("SurfaceAppearance") then
					child:Destroy()
				end
			end
			if saCopy then
				saCopy:Clone().Parent = target
			end
		end)

		local ok = pcall(function()
			target.MeshId = src.MeshId
			target.TextureID = src.TextureID
		end)
		if not ok then return false end
		pcall(function() target.Size = src.Size end)
		for _, child in ipairs(target:GetChildren()) do
			if child:IsA("SurfaceAppearance") then
				child:Destroy()
			end
		end
		local sa = src:FindFirstChildOfClass("SurfaceAppearance")
		if sa then
			sa:Clone().Parent = target
		end
		return true
	end

	local tm = target:FindFirstChildOfClass("SpecialMesh")
	local sm = src:FindFirstChildOfClass("SpecialMesh")
	if tm and sm then
		local a, b, c, d = tm.MeshId, tm.TextureId, tm.Scale, tm.Offset
		remember("r15sm:" .. target.Name, function()
			pcall(function()
				tm.MeshId = a
				tm.TextureId = b
				tm.Scale = c
				tm.Offset = d
			end)
		end)
		pcall(function()
			tm.MeshId = sm.MeshId
			tm.TextureId = sm.TextureId
			tm.Scale = sm.Scale
			tm.Offset = sm.Offset
		end)
		return true
	end
	return false
end

-- R6: head uses mesh, limbs become blocks (color + texture decals)
local function applyR6(char, partKey, loaded)
	local target = char:FindFirstChild(R6_TARGETS[partKey])
	if not target then return false end
	local src = findSource(loaded, partKey)
	if not src then return false end

	if partKey == "Head" then
		local sm = target:FindFirstChildOfClass("SpecialMesh")
		if not sm then return false end
		local a, b, c, d, e = sm.MeshId, sm.TextureId, sm.Scale, sm.Offset, sm.MeshType
		remember("r6:Head", function()
			pcall(function()
				sm.MeshType = e
				sm.MeshId = a
				sm.TextureId = b
				sm.Scale = c
				sm.Offset = d
			end)
		end)

		local srcSm = src:FindFirstChildOfClass("SpecialMesh")
		local ok = pcall(function()
			if srcSm then
				sm.MeshId = srcSm.MeshId
				sm.TextureId = srcSm.TextureId
				sm.Scale = srcSm.Scale
				sm.Offset = srcSm.Offset
			elseif src:IsA("MeshPart") then
				sm.MeshType = Enum.MeshType.FileMesh
				sm.MeshId = src.MeshId
				sm.TextureId = textureOf(src)
				sm.Scale = Vector3.new(1, 1, 1)
				sm.Offset = Vector3.new(0, 0, 0)
			end
		end)
		return ok
	end

	local color0 = target.Color
	remember("r6:" .. target.Name, function()
		pcall(function() target.Color = color0 end)
		for _, child in ipairs(target:GetChildren()) do
			if child.Name == "BBDecal" then
				child:Destroy()
			end
		end
	end)

	pcall(function() target.Color = src.Color end)
	for _, child in ipairs(target:GetChildren()) do
		if child.Name == "BBDecal" then
			child:Destroy()
		end
	end
	local tex = textureOf(src)
	if tex ~= "" then
		for _, face in ipairs(Enum.NormalId:GetEnumItems()) do
			create("Decal", {
				Name = "BBDecal",
				Texture = tex,
				Face = face,
			}, target)
		end
	end
	return true
end

local function applyPart(partKey, assetId)
	local char = player.Character
	if not char or not getHumanoid() then
		return false, "Character not found"
	end

	local loaded = loadAsset(assetId)
	if not loaded then
		return false, "Failed to load asset"
	end

	local done = 0
	if isR6() then
		if applyR6(char, partKey, loaded) then
			done = 1
		end
	else
		for _, name in ipairs(PART_MESHES[partKey]) do
			local src = findPart(loaded, name)
			local target = char:FindFirstChild(name)
			if src and target and swapMeshR15(target, src) then
				done = done + 1
			end
		end
	end
	loaded:Destroy()

	if done == 0 then
		return false, "Could not apply " .. PART_NAMES[partKey] .. " (executor may block it)"
	end
	return true, PART_NAMES[partKey] .. " applied"
end

local function resetAvatar()
	local n = 0
	for _, fn in pairs(origs) do
		pcall(fn)
		n = n + 1
	end
	origs = {}
	if n > 0 then
		setStatus("Avatar restored", "ok")
	else
		setStatus("Nothing to restore")
	end
end

resetBtn.Activated:Connect(resetAvatar)

-- BUNDLES ----------------------------------------------------------------------
local bundleCache = {}

local function resolveBundle(bundleId)
	if bundleCache[bundleId] then
		return bundleCache[bundleId]
	end

	local ok, details = pcall(function()
		return AssetService:GetBundleDetailsAsync(bundleId)
	end)
	if not ok or not details then
		return nil
	end

	local parts = {}

	for _, item in ipairs(details.Items) do
		if item.Type == "UserOutfit" then
			local okO, outfit = pcall(function()
				return Players:GetHumanoidDescriptionFromOutfitId(item.Id)
			end)
			if okO and outfit then
				for _, key in ipairs(PART_ORDER) do
					if outfit[key] ~= 0 then
						parts[key] = outfit[key]
					end
				end
			end
		end
	end

	for _, item in ipairs(details.Items) do
		if item.Type == "Asset" then
			local okI, info = pcall(function()
				return MarketplaceService:GetProductInfo(item.Id, Enum.InfoType.Asset)
			end)
			if okI and info then
				local part = TYPE_TO_PART[info.AssetTypeId]
				if part then
					parts[part] = item.Id
				end
			end
		end
	end

	local result = { Id = bundleId, Name = details.Name, Parts = parts }
	bundleCache[bundleId] = result
	return result
end

local function clearChildrenOf(container)
	for _, child in ipairs(container:GetChildren()) do
		if child:IsA("GuiObject") then
			child:Destroy()
		end
	end
end

local currentBundle = nil

local function partCard(partKey, assetId)
	local card = create("TextButton", {
		Text = "",
		BackgroundColor3 = C_CARD,
		BorderSizePixel = 0,
		ZIndex = 14,
	}, pickerScroll)
	corner(card, 8)
	pressable(card, C_CARD, C_CARD_HOVER)

	create("ImageLabel", {
		Image = ("rbxthumb://type=Asset&id=%d&w=150&h=150"):format(assetId),
		BackgroundColor3 = C_SURFACE,
		BorderSizePixel = 0,
		ZIndex = 15,
		Size = UDim2.new(1, -8, 0, 86),
		Position = UDim2.fromOffset(4, 4),
	}, card)

	create("TextLabel", {
		Text = PART_NAMES[partKey],
		Font = Enum.Font.GothamBold,
		TextSize = 12,
		TextColor3 = C_TEXT,
		TextWrapped = true,
		BackgroundTransparency = 1,
		ZIndex = 15,
		Size = UDim2.new(1, -4, 0, 28),
		Position = UDim2.new(0, 2, 1, -30),
	}, card)

	card.Activated:Connect(function()
		setStatus("Applying " .. PART_NAMES[partKey] .. "...")
		local ok, msg = applyPart(partKey, assetId)
		setStatus(msg, ok and "ok" or "warn")
	end)
end

local function openPicker(bundleRef)
	setStatus("Loading bundle parts...")
	local data = resolveBundle(bundleRef.Id)
	if not data then
		setStatus("Bundle not found", "warn")
		return
	end

	clearChildrenOf(pickerScroll)
	local found = 0
	for _, key in ipairs(PART_ORDER) do
		if data.Parts[key] then
			partCard(key, data.Parts[key])
			found = found + 1
		end
	end

	if found == 0 then
		setStatus("This bundle has no body parts", "warn")
		return
	end

	currentBundle = data
	pickerTitle.Text = tostring(data.Name or data.Id)
	if isR6() then
		pickerNote.Text = "R6: limbs are applied as blocks (color/texture)"
	else
		pickerNote.Text = "R15: full mesh swap"
	end
	showPicker(true)
	setStatus(found .. " parts found. Pick one or apply all.")
end

wearAllBtn.Activated:Connect(function()
	if not currentBundle then return end
	local okCount, total = 0, 0
	local lastMsg = ""
	for _, key in ipairs(PART_ORDER) do
		local id = currentBundle.Parts[key]
		if id then
			total = total + 1
			setStatus("Applying " .. PART_NAMES[key] .. "...")
			local ok, msg = applyPart(key, id)
			lastMsg = msg
			if ok then okCount = okCount + 1 end
		end
	end
	if okCount == total then
		setStatus("Applied: " .. tostring(currentBundle.Name), "ok")
	else
		setStatus(okCount .. "/" .. total .. " parts applied. " .. lastMsg, "warn")
	end
end)

-- SEARCH + GRID -------------------------------------------------------------------
local pages = nil
local seen = {}
local count = 0
local loading = false

local function addCard(item)
	if seen[item.Id] then return end
	seen[item.Id] = true
	count = count + 1

	local card = create("TextButton", {
		Text = "",
		BackgroundColor3 = C_CARD,
		BorderSizePixel = 0,
	}, scroll)
	corner(card, 8)
	pressable(card, C_CARD, C_CARD_HOVER)

	create("ImageLabel", {
		Image = ("rbxthumb://type=BundleThumbnail&id=%d&w=150&h=150"):format(item.Id),
		BackgroundColor3 = C_SURFACE,
		BorderSizePixel = 0,
		Size = UDim2.new(1, -8, 0, 86),
		Position = UDim2.fromOffset(4, 4),
	}, card)

	create("TextLabel", {
		Text = tostring(item.Name or item.Id),
		Font = Enum.Font.GothamBold,
		TextSize = 11,
		TextColor3 = C_TEXT,
		TextWrapped = true,
		BackgroundTransparency = 1,
		Size = UDim2.new(1, -4, 0, 28),
		Position = UDim2.new(0, 2, 1, -30),
	}, card)

	card.Activated:Connect(function()
		openPicker({ Id = item.Id, Name = item.Name })
	end)
end

local function isBundle(item)
	return item.ItemType == Enum.AvatarItemType.Bundle or item.ItemType == "Bundle"
end

local function addCurrentPage()
	local okP, current = pcall(function()
		return pages:GetCurrentPage()
	end)
	if not okP or type(current) ~= "table" then return 0 end

	local before = count
	for _, item in ipairs(current) do
		if isBundle(item) then
			addCard(item)
		end
	end
	return count - before
end

local function updateStatus()
	local finished = pages and pages.IsFinished
	setStatus("Bundles loaded: " .. count .. (finished and " (all pages loaded)" or " (more pages available)"))
	moreBtn.Text = finished and "All Loaded" or "Load More"
end

local function loadMore()
	if loading or not pages or pages.IsFinished then return end
	loading = true
	setStatus("Loading next page...")
	local ok = pcall(function()
		pages:AdvanceToNextPageAsync()
	end)
	if ok then
		addCurrentPage()
	end
	loading = false
	updateStatus()
end

local function startSearch()
	if loading then return end
	loading = true
	setStatus("Searching...")
	clearChildrenOf(scroll)
	seen = {}
	count = 0
	pages = nil

	local ok, result = pcall(function()
		local params = CatalogSearchParams.new()
		params.SearchKeyword = searchBox.Text
		params.BundleTypes = FILTERS[filterIndex][2]
		return AvatarEditorService:SearchCatalog(params)
	end)

	if not ok or not result then
		setStatus("Search failed: " .. tostring(result), "warn")
		loading = false
		return
	end

	pages = result
	addCurrentPage()

	local guard = 0
	while count < 18 and not pages.IsFinished and guard < 6 do
		guard = guard + 1
		local okN = pcall(function()
			pages:AdvanceToNextPageAsync()
		end)
		if not okN then break end
		addCurrentPage()
	end

	loading = false
	updateStatus()
end

searchBtn.Activated:Connect(startSearch)
searchBox.FocusLost:Connect(function(enterPressed)
	if enterPressed then startSearch() end
end)

filterBtn.Activated:Connect(function()
	filterIndex = filterIndex + 1
	if filterIndex > #FILTERS then filterIndex = 1 end
	filterBtn.Text = FILTERS[filterIndex][1]
	startSearch()
end)

moreBtn.Activated:Connect(loadMore)

scroll:GetPropertyChangedSignal("CanvasPosition"):Connect(function()
	local bottom = scroll.CanvasPosition.Y + scroll.AbsoluteWindowSize.Y
	if scroll.AbsoluteCanvasSize.Y > 0 and bottom >= scroll.AbsoluteCanvasSize.Y - 40 then
		loadMore()
	end
end)

idBtn.Activated:Connect(function()
	local id = tonumber(idBox.Text)
	if not id then
		setStatus("Invalid ID", "warn")
		return
	end
	openPicker({ Id = math.floor(id) })
end)

startSearch()
