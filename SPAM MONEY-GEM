-- Spam Dig Logic (0.1s Delay)
local function startDigging()
	task.spawn(function()
		while isDigging do
			for i = 1, 50 do
				if not isDigging then break end
				digEvent:FireServer("hello")
			end
			task.wait(0.1)
		end
	end)
end

DigBtn.MouseButton1Click:Connect(function()
	isDigging = not isDigging
	if isDigging then
		DigBtn.Text = "SPAM DIG: ON"
		DigBtn.TextColor3 = Color3.fromRGB(255, 0, 50)
		startDigging()
	else
		DigBtn.Text = "SPAM DIG: OFF"
		DigBtn.TextColor3 = Color3.fromRGB(255, 255, 255)
	end
end)

-- Spam Gem Logic (GemEvent + TreasureEvent, 0.1s Delay)
local function startGemming()
