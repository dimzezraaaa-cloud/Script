local SERVER_SOURCE = [==[
local Players = game:GetService("Players")
local ReplicatedStorage = game:GetService("ReplicatedStorage")
local MessagingService = game:GetService("MessagingService")

-- ====== SETTINGS ======
local ADMIN_ONLY = false      -- false = everyone (testing), true = only ADMINS
local ADMINS = {
	[123456789] = true,       -- your UserId
}
local CASH_NAME = "Cash"      -- leaderstats stat name
local GLOBAL_TOPIC = "AdminGlobalAnnounce"
-- ======================

local function allowed(plr)
	if not ADMIN_ONLY then
		return true
	end
	return ADMINS[plr.UserId] == true
end

local NAMES = { "K", "M", "B", "T", "Qa", "Qi", "Sx", "Sp", "Oc", "No", "Dc",
	"Ud", "Dd", "Td", "Qad", "Qid", "Sxd", "Spd", "Ocd", "Nod", "Vg" }
local SUFFIX = {}
for i, name in ipairs(NAMES) do
	SUFFIX[string.lower(name)] = 10 ^ (3 * i)
end

local function parseAmount(text)
	local s = string.lower((string.gsub(text or "", "[%s,_]", "")))
	if s == "" then
		return nil
	end
	local n = tonumber(s)
	if not n then
		local num, suf = string.match(s, "^([%-%+]?[%d%.]+)(%a+)$")
		local mult = suf and SUFFIX[suf]
		if not mult then
			return nil
		end
		n = tonumber(num)
		if not n then
			return nil
		end
		n = n * mult
	end
	if n ~= n or n == math.huge or n == -math.huge then
		return nil
	end
	return n
end

local function short(n)
	local sign = ""
	if n < 0 then
		sign = "-"
		n = -n
	end
	if n < 1000 then
		return sign .. tostring(math.floor(n * 100 + 0.5) / 100)
	end
	local i = math.floor(math.log10(n) / 3)
	if i > #NAMES then
		i = #NAMES
	end
	local v = n / (10 ^ (3 * i))
	return sign .. tostring(math.floor(v * 100 + 0.5) / 100) .. NAMES[i]
end

local function str(x, max)
	if type(x) ~= "string" then
		return ""
	end
	return string.sub(x, 1, max)
end

local function findPlayer(caller, name)
	name = string.lower(name or "")
	if name == "" or name == "me" then
		return caller
	end
	local found = nil
	for _, p in ipairs(Players:GetPlayers()) do
		local n = string.lower(p.Name)
		local d = string.lower(p.DisplayName)
		if n == name or d == name then
			return p
		end
		if not found then
			if string.find(n, name, 1, true) or string.find(d, name, 1, true) then
				found = p
			end
		end
	end
	return found
end

local function getChar(p)
	local ch = p.Character
	if not ch then
		return nil, nil
	end
	return ch:FindFirstChildOfClass("Humanoid"), ch:FindFirstChild("HumanoidRootPart")
end

local handlers = {}

handlers.AdminKill = function(plr, a)
	local target = findPlayer(plr, str(a, 50))
	if not target then
		return false, "Player not found"
	end
	local hum = getChar(target)
	if not hum then
		return false, "Character not ready"
	end
	hum.Health = 0
	return true, "Killed " .. target.Name
end

handlers.AdminBring = function(plr, a)
	local target = findPlayer(plr, str(a, 50))
	if not target then
		return false, "Player not found"
	end
	local _, aRoot = getChar(plr)
	local _, tRoot = getChar(target)
	if not aRoot or not tRoot then
		return false, "Character not ready"
	end
	tRoot.CFrame = aRoot.CFrame * CFrame.new(0, 0, -5)
	return true, "Brought " .. target.Name
end

handlers.AdminGoto = function(plr, a)
	local target = findPlayer(plr, str(a, 50))
	if not target then
		return false, "Player not found"
	end
	local _, aRoot = getChar(plr)
	local _, tRoot = getChar(target)
	if not aRoot or not tRoot then
		return false, "Character not ready"
	end
	aRoot.CFrame = tRoot.CFrame * CFrame.new(0, 0, 5)
	return true, "Teleported to " .. target.Name
end

handlers.AdminCash = function(plr, a, b)
	local target = findPlayer(plr, str(a, 50))
	if not target then
		return false, "Player not found"
	end
	local n = parseAmount(str(b, 40))
	if not n then
		return false, "Bad amount. Examples: 500, 1K, 2.5M, 1T, 1Sp"
	end
	local ls = target:FindFirstChild("leaderstats")
	if not ls then
		ls = Instance.new("Folder")
		ls.Name = "leaderstats"
		ls.Parent = target
	end
	local stat = ls:FindFirstChild(CASH_NAME)
	if not stat then
		stat = Instance.new("NumberValue")
		stat.Name = CASH_NAME
		stat.Parent = ls
	end
	local new = stat.Value + n
	if stat:IsA("IntValue") and (new > 9e18 or new < -9e18) then
		return false, CASH_NAME .. " is an IntValue (max ~9Qi). Use NumberValue for bigger"
	end
	stat.Value = new
	return true, target.Name .. " " .. CASH_NAME .. " " .. short(n) .. " -> " .. short(stat.Value)
end

handlers.AdminKick = function(plr, a, b)
	local name = str(a, 50)
	if name == "" then
		return false, "Enter a player name"
	end
	local target = findPlayer(plr, name)
	if not target then
		return false, "Player not found"
	end
	local reason = str(b, 100)
	if reason == "" then
		reason = "Kicked by admin"
	end
	local nm = target.Name
	target:Kick(reason)
	return true, "Kicked " .. nm
end

handlers.AdminBan = function(plr, a, b, c)
	local name = str(a, 50)
	if name == "" then
		return false, "Enter a player name"
	end
	local reason = str(b, 100)
	if reason == "" then
		return false, "Reason required"
	end
	local days = tonumber(str(c, 10))
	if not days or days < 0 then
		days = 0
	end

	local userId = nil
	local target = findPlayer(plr, name)
	if target and string.lower(name) ~= "me" then
		userId = target.UserId
	else
		local ok, id = pcall(function()
			return Players:GetUserIdFromNameAsync(name)
		end)
		if ok then
			userId = id
		end
	end
	if not userId then
		return false, "User not found"
	end
	if userId == plr.UserId then
		return false, "You cannot ban yourself"
	end

	local duration = -1
	if days > 0 then
		duration = math.floor(days * 86400)
	end

	local ok, err = pcall(function()
		Players:BanAsync({
			UserIds = { userId },
			Duration = duration,
			DisplayReason = reason,
			PrivateReason = reason .. " (by " .. plr.Name .. ")",
			ExcludeAltAccounts = false,
			ApplyToUniverse = true,
		})
	end)
	if not ok then
		return false, "Ban failed: " .. tostring(err)
	end

	if target and target.Parent then
		target:Kick("Banned: " .. reason)
	end

	if days > 0 then
		return true, "Banned " .. name .. " for " .. days .. " day(s)"
	end
	return true, "Banned " .. name .. " permanently"
end

local announceEvent = nil
local subscribed = false

local function showToAll(name, msg, userId)
	if announceEvent then
		announceEvent:FireAllClients("Show", name, msg, userId)
	end
end

local function setupGlobal()
	local ok = pcall(function()
		MessagingService:SubscribeAsync(GLOBAL_TOPIC, function(message)
			local d = message.Data
			if type(d) == "table" then
				showToAll(str(d.n, 50), str(d.m, 200), tonumber(d.u))
			end
		end)
	end)
	subscribed = ok
	if not ok then
		warn("[AdminServer] MessagingService unavailable: Global announce falls back to this server")
	end
end

handlers.AdminAnnounce = function(plr, a, b)
	local msg = str(a, 200)
	if msg == "" then
		return false, "Type an announcement first"
	end
	local scope = str(b, 10)

	if scope == "Global" then
		if subscribed then
			local ok, err = pcall(function()
				MessagingService:PublishAsync(GLOBAL_TOPIC, { n = plr.DisplayName, m = msg, u = plr.UserId })
			end)
			if ok then
				return true, "Global announcement sent"
			end
			warn("[AdminServer] Publish failed: " .. tostring(err))
		end
		showToAll(plr.DisplayName, msg, plr.UserId)
		return true, "Global unavailable. Sent to this server only"
	end

	showToAll(plr.DisplayName, msg, plr.UserId)
	return true, "Server announcement sent"
end

local function hook(name)
	local ev = ReplicatedStorage:WaitForChild(name, 10)
	if not ev then
		warn("[AdminServer] Missing RemoteEvent: " .. name)
		return
	end
	if name == "AdminAnnounce" then
		announceEvent = ev
	end
	ev.OnServerEvent:Connect(function(plr, a, b, c)
		if not allowed(plr) then
			ev:FireClient(plr, "Status", "Not allowed", false)
			return
		end
		local success, ok, msg = pcall(handlers[name], plr, a, b, c)
		if not success then
			warn("[AdminServer] " .. name .. " error: " .. tostring(ok))
			ev:FireClient(plr, "Status", "Server error", false)
			return
		end
		ev:FireClient(plr, "Status", tostring(msg), ok == true)
	end)
end

for name, _ in pairs(handlers) do
	spawn(function()
		hook(name)
	end)
end

spawn(setupGlobal)
]==]

