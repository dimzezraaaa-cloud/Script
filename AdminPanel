local isOpen = false
local busy = false

local function setOpen(state)
	if busy or state == isOpen then
		return
	end
	busy = true
	isOpen = state

	if state then
		winScale.Scale = fit * 0.7
		window.Rotation = -6
		window.Position = UDim2.new(0.5, 0, 0.5, 50)
		window.BackgroundTransparency = 1
		if winStroke then winStroke.Transparency = 1 end
		header.Position = UDim2.new(0, 0, 0, -40)
		window.Visible = true

		tween(winScale, 0.42, { Scale = fit }, Enum.EasingStyle.Back)
		tween(window, 0.42, { Rotation = 0, Position = CENTER }, Enum.EasingStyle.Back)
		tween(window, 0.25, { BackgroundTransparency = 0.5 })
		if winStroke then tween(winStroke, 0.25, { Transparency = 0.6 }) end
		tween(blur, 0.3, { Size = 12 })

		delay(0.06, function()
			tween(header, 0.4, { Position = UDim2.new(0, 0, 0, 0) }, Enum.EasingStyle.Back)
		end)
		delay(0.45, function()
			busy = false
		end)
	else
		tween(winScale, 0.2, { Scale = fit * 0.8 }, Enum.EasingStyle.Back, Enum.EasingDirection.In)
		tween(window, 0.2, { Rotation = 5, Position = UDim2.new(0.5, 0, 0.5, 40), BackgroundTransparency = 1 })
		if winStroke then tween(winStroke, 0.2, { Transparency = 1 }) end
		tween(header, 0.2, { Position = UDim2.new(0, 0, 0, -30) })
		tween(blur, 0.2, { Size = 0 })
		delay(0.2, function()
			window.Visible = false
			busy = false
		end)
	end
