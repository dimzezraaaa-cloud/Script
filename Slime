-- Farm Money Logic (1 to 100, String Index)
local function startFarming()
	task.spawn(function()
		while isFarming do
			for i = 1, 100 do
				if not isFarming then break end
				collectEarningsEvent:FireServer(tostring(i))
			end
			task.wait(0.1)
		end
	end)
end

FarmBtn.MouseButton1Click:Connect(function()
	isFarming = not isFarming
	if isFarming then
		FarmBtn.Text = "FARM: ON"
		FarmBtn.TextColor3 = Color3.fromRGB(255, 0, 50)
		startFarming()
	else
		FarmBtn.Text = "FARM: OFF"
		FarmBtn.TextColor3 = Color3.fromRGB(255, 255, 255)
	end
end)

-- Auto Upgrade Slime Logic (1 to 100, String Index, 0.5s Delay)
local function startUpgrading()
	task.spawn(function()
		while isUpgrading do
			for i = 1, 100 do
				if not isUpgrading then break end
				upgradeSlimeEvent:FireServer(tostring(i))
			end
			task.wait(0.5)
		end
	end)
end

