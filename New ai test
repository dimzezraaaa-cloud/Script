end

local function genTitle(chat, p)
	local first = chat.messages[1] and chat.messages[1].content or ""
	local second = chat.messages[2] and chat.messages[2].content or ""
	local fallback = trim((first:gsub("%s+", " "))):sub(1, 28)
	local t = callProvider(p, { {
		role = "user",
		content = "Conversation:\nUser: " .. first:sub(1, 300) .. "\nAssistant: " .. second:sub(1, 300)
			.. "\n\nWrite a title for this conversation in 2 to 4 words. Reply with the title only.",
	} }, "You write very short English chat titles. Output only the title, with no quotes and no trailing punctuation.")
	if type(t) == "string" then
		t = t:gsub("[\r\n]+", " ")
		t = t:gsub("[\"'`*#]", "")
		t = trim(t):sub(1, 32)
	end
	if not t or #t == 0 then t = fallback end
	if #t == 0 then t = "New chat" end
	if chat.auto ~= false then
		chat.title = t
		saveChats()
		refreshTitle()
		refreshChats()
	end
end

local function ask(text)
	busy = true
	lastPrompt = text
	local chat = activeChat
	local isNew = (#chat.messages == 0)
	table.insert(chat.messages, { role = "user", content = text })
	chat.updated = os.time()
	local listed = false
	for _, c in ipairs(chats) do if c == chat then listed = true break end end
	if not listed then table.insert(chats, chat) end
	saveChats()

	local p = providers[current]
	local thinking = out(esc(p.name .. " is thinking"), C.dim)
	local alive = true
	task.spawn(function()
		local n = 0
		while alive and thinking and thinking.Parent do
			n = n % 3 + 1
			thinking.Text = '<font color="' .. hex(C.dim) .. '">' .. esc(p.name .. " is thinking") .. string.rep(".", n) .. "</font>"
			task.wait(0.4)
		end
	end)

	task.spawn(function()
		local reply, err = callProvider(p, window(chat.messages), systemPrompt)
		alive = false
		if thinking and thinking.Parent then thinking:Destroy() end
		if reply then
			table.insert(chat.messages, { role = "assistant", content = reply })
			chat.updated = os.time()
			saveChats()
			if activeChat == chat then printReply(reply) end
			busy = false
			if isNew and chat.auto ~= false then
				task.spawn(function() pcall(genTitle, chat, p) end)
			end
		else
			table.remove(chat.messages)
			saveChats()
			if activeChat == chat then out("error: " .. esc(tostring(err)), C.err) end
			busy = false
		end
		refreshChats()
	end)
end

--// COMMANDS
local function help()
	out([[commands:
  /help            show this help
  /new             start a new chat
  /chats           open the chat list
  /rename <name>   rename the current chat
  /delete          delete the current chat
  /clear           clear the current chat (screen + memory)
  /wipe confirm    delete ALL chats
  /models          list models
  /model <no>      switch model
  /api             add a custom API (name + key only)
  /setmodel <id>   change the model ID of the active custom API
  /system <text>   set system prompt (/system reset)
  /retry           resend your last message
  /run [no]        execute a code block
  /copy [no]       copy a code block
  /export          copy the whole chat as text
anything else is sent to the active model.]], C.dim)
end

handleCommand = function(line)
	local cmd, arg = line:match("^/(%S+)%s*(.*)$")
	cmd = cmd and cmd:lower()
	arg = trim(arg)
	if cmd == "help" then
		help()
	elseif cmd == "new" then
		newChat()
	elseif cmd == "chats" then
		refreshChats()
		showPanel(chatsPanel)
	elseif cmd == "rename" then
		if #arg == 0 then out("usage: /rename <name>", C.err) return end
		activeChat.title = arg:sub(1, 40)
		activeChat.auto = false
		local listed = false
		for _, c in ipairs(chats) do if c == activeChat then listed = true break end end
		if listed then saveChats() end
		refreshTitle()
		refreshChats()
		out("chat renamed.", C.warn)
	elseif cmd == "delete" then
		for i, c in ipairs(chats) do
			if c == activeChat then table.remove(chats, i) break end
		end
		saveChats()
		newChat()
		refreshChats()
		out("chat deleted.", C.warn)
	elseif cmd == "clear" then
		if activeChat then
			activeChat.messages = {}
			activeChat.updated = os.time()
			local listed = false
			for _, c in ipairs(chats) do if c == activeChat then listed = true break end end
			if listed then saveChats() end
		end
		clearScreen()
		refreshChats()
	elseif cmd == "wipe" then
		if arg:lower() ~= "confirm" then
			out("this deletes ALL chats. type /wipe confirm to continue.", C.warn)
			return
		end
		chats = {}
		saveChats()
		newChat()
		refreshChats()
		out("all chats deleted.", C.warn)
	elseif cmd == "models" then
		for i, p in ipairs(providers) do
			out(((i == current) and "> " or "  ") .. i .. ". " .. esc(p.name) .. "  [" .. esc(p.model) .. "]", (i == current) and C.prompt or C.text)
		end
	elseif cmd == "model" then
		local n = tonumber(arg)
		if n and providers[n] then
			current = n
			refreshModels()
			refreshTitle()
			out("model -> " .. esc(providers[n].name), C.warn)
		else
			out("usage: /model <1-" .. #providers .. ">", C.err)
		end
	elseif cmd == "setmodel" then
		local p = providers[current]
		if p.builtin then out("the built-in model cannot be changed.", C.err) return end
		if #arg == 0 then out("current model id: " .. esc(p.model), C.dim) return end
		p.model = arg
		if p.saved then persistAPIs() end
		refreshModels()
		out("model id -> " .. esc(arg), C.warn)
	elseif cmd == "api" then
		status.Text = ""
		showPanel(apiPanel)
	elseif cmd == "system" then
		if #arg == 0 then
			out("system prompt: " .. esc(systemPrompt), C.dim)
		elseif arg:lower() == "reset" then
			systemPrompt = BASE_SYSTEM
			out("system prompt reset.", C.warn)
		else
			systemPrompt = arg
			out("system prompt updated.", C.warn)
		end
	elseif cmd == "retry" then
		local msgs = activeChat.messages
		if msgs[#msgs] and msgs[#msgs].role == "assistant" then table.remove(msgs) end
		if msgs[#msgs] and msgs[#msgs].role == "user" then lastPrompt = table.remove(msgs).content end
		if not lastPrompt then out("nothing to retry.", C.err) return end
		if busy then out("still waiting for the previous reply...", C.warn) return end
		openChat(activeChat)
		echo(lastPrompt)
		ask(lastPrompt)
	elseif cmd == "run" or cmd == "copy" then
		local n = tonumber(arg) or #codes
		local code = codes[n]
		if not code then out("no code block #" .. tostring(n), C.err) return end
		if cmd == "copy" then
			local ok = copyText(code)
			out(ok and ("code #" .. n .. " copied.") or "your executor has no clipboard.", ok and C.warn or C.err)
		else
			local fn, err = loadstring(code)
			if not fn then out("syntax error: " .. esc(tostring(err)), C.err) return end
			task.spawn(function()
				local ok, e = pcall(fn)
				if ok then out("code #" .. n .. " executed successfully.", C.prompt)
				else out("runtime error: " .. esc(tostring(e)), C.err) end
			end)
		end
	elseif cmd == "export" then
		local buf = { "# " .. (activeChat.title or "Chat") }
		for _, m in ipairs(activeChat.messages) do
			table.insert(buf, (m.role == "user" and "You: " or "AI: ") .. m.content)
		end
		local ok = copyText(table.concat(buf, "\n\n"))
		out(ok and "chat copied to clipboard." or "your executor has no clipboard.", ok and C.warn or C.err)
	else
		out("unknown command. type /help", C.err)
	end
end

local function submit()
	local text = trim(box.Text)
	box.Text = ""
	if #text == 0 then return end
	if text:sub(1, 1) == "/" then
		echo(text)
		handleCommand(text)
	elseif busy then
		out("still waiting for the previous reply...", C.warn)
	else
		echo(text)
		ask(text)
	end
end

box.FocusLost:Connect(function(enter)
	if enter then
		submit()
		if not UIS.TouchEnabled then box:CaptureFocus() end
	end
end)

