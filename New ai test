	testing = true
	status.Text, status.TextColor3 = "Testing your key against all providers...", C.warn
	local cnd, results, softWarn = probeKey(key)
	testing = false
	if not cnd then
		local lines = { "This key did not work with any provider:" }
		for i, c in ipairs(CANDIDATES) do
			lines[#lines + 1] = c.label .. ": " .. tostring(results[i] or "timeout"):sub(1, 70)
		end
