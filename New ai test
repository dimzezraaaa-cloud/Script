local function splitBlocks(text)
	local parts, pos = {}, 1
	while true do
		local s, e, _, code = text:find("```(%w*)\n?(.-)```", pos)
		if not s then break end
		if s > pos then table.insert(parts, { type = "text", text = text:sub(pos, s - 1) }) end
		table.insert(parts, { type = "code", text = code })
		pos = e + 1
	end
	if pos <= #text then table.insert(parts, { type = "text", text = text:sub(pos) }) end
	return parts
end

local function printReply(text)
	for _, p in ipairs(splitBlocks(text)) do
		if p.type == "code" then
			local code = trim(p.text)
			if #code > 0 then
				table.insert(codes, code)
				codeBox(code, #codes)
			end
		else
			local t = trim(p.text)
			if #t > 0 then out(esc(t), nil, true) end
		end
	end
	scrollDown()
end

--// NETWORK
local req = (syn and syn.request) or (http and http.request) or http_request or request
	or (fluxus and fluxus.request)

local function jpost(url, headers, body)
	if not req then return nil, "your executor has no request function" end
	local ok, res = pcall(req, { Url = url, Method = "POST", Headers = headers, Body = HttpService:JSONEncode(body) })
	if not ok then return nil, tostring(res) end
	local okJ, data = pcall(function() return HttpService:JSONDecode(res.Body) end)
	return res, okJ and data or nil
end

local function errText(data, res)
	if type(data) == "table" and data.error then
		if type(data.error) == "table" then return tostring(data.error.message or data.error.type or "unknown error") end
		return tostring(data.error)
	end
	return "HTTP " .. tostring(res and res.StatusCode)
end

local function callProvider(p, msgs, system)
	if p.kind == "free" then
		local full = { { role = "system", content = system } }
		for _, m in ipairs(msgs) do table.insert(full, m) end
		local res, data = jpost("https://text.pollinations.ai/openai", { ["Content-Type"] = "application/json" },
			{ model = p.model, messages = full })
		if res and type(data) == "table" and data.choices and data.choices[1] and data.choices[1].message then
			return data.choices[1].message.content
		end
		local last = msgs[#msgs].content:sub(1, 1200)
		local ok, body = pcall(function()
			return game:HttpGet("https://text.pollinations.ai/" .. HttpService:UrlEncode(last)
				.. "?system=" .. HttpService:UrlEncode(system))
		end)
		if ok and body and #body > 0 then return body end
		return nil, "the free provider is unavailable right now"
	elseif p.kind == "anthropic" then
		local res, data = jpost(p.url, {
			["Content-Type"] = "application/json", ["x-api-key"] = p.key or "", ["anthropic-version"] = "2023-06-01",
		}, { model = p.model, max_tokens = 2048, system = system, messages = msgs })
		if not res then return nil, data end
		if type(data) == "table" and data.content then
			local buf = {}
			for _, b in ipairs(data.content) do
				if b.type == "text" then table.insert(buf, b.text) end
			end
			if #buf > 0 then return table.concat(buf, "\n") end
		end
		return nil, errText(data, res)
	else
		local full = { { role = "system", content = system } }
		for _, m in ipairs(msgs) do table.insert(full, m) end
		local headers = { ["Content-Type"] = "application/json" }
		if p.key and p.key ~= "" then headers.Authorization = "Bearer " .. p.key end
		local res, data = jpost(p.url, headers, { model = p.model, messages = full })
		if not res then return nil, data end
		if type(data) == "table" and data.choices and data.choices[1] and data.choices[1].message then
			return data.choices[1].message.content
		end
		return nil, errText(data, res)
	end
end

local function window(msgs)
	local o = {}
	for i = math.max(1, #msgs - 19), #msgs do o[#o + 1] = { role = msgs[i].role, content = msgs[i].content } end
	while o[1] and o[1].role ~= "user" do table.remove(o, 1) end
	return o
end

