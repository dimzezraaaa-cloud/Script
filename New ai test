local iconCache = {}
local function resolveIcon(name)
	if iconCache[name] ~= nil then return iconCache[name] end
	local result = false
	if lucide then
		for _, fn in ipairs({ "Icon", "GetIcon", "Image", "Get" }) do
			if type(lucide[fn]) == "function" then
				local ok, a, b, c = pcall(lucide[fn], name)
				if ok and a then result = { a, b, c } break end
			end
		end
	end
	iconCache[name] = result
	return result
end

local function applyIcon(img, name)
	local r = resolveIcon(name)
	if not r then return false end
	local a, b, c = r[1], r[2], r[3]
	local image, rsize, rpos
	if type(a) == "table" then
		image = a.Image or a.ImageId or a.Id
		rsize = a.ImageRectSize
		rpos = a.ImageRectPosition or a.ImageRectOffset
	else
		image = a
		if type(b) == "table" then
			rsize = b.ImageRectSize
			rpos = b.ImageRectPosition or b.ImageRectOffset
		else
			rsize, rpos = b, c
		end
	end
	if not image then return false end
	if type(image) == "number" or tostring(image):match("^%d+$") then
		image = "rbxassetid://" .. tostring(image)
	end
	img.Image = tostring(image)
	if typeof(rsize) == "Vector2" then img.ImageRectSize = rsize end
	if typeof(rpos) == "Vector2" then img.ImageRectOffset = rpos end
	return true
end

