-- Press / hold detection (works for mouse + touch)
local function attachHold(btn, onClick, onHold)
	local down, held, id = false, false, 0
	btn.InputBegan:Connect(function(i)
		if i.UserInputType ~= Enum.UserInputType.MouseButton1 and i.UserInputType ~= Enum.UserInputType.Touch then return end
		down, held = true, false
		id += 1
		local my = id
		local start = i.Position
		task.delay(0.45, function()
			if down and id == my and (i.Position - start).Magnitude < 12 then
				held = true
				onHold()
			end
		end)
		i.Changed:Connect(function()
			if i.UserInputState == Enum.UserInputState.End then
				if down and not held and id == my and (i.Position - start).Magnitude < 12 then onClick() end
				down = false
			end
		end)
	end)
end

