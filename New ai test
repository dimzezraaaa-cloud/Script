local testing = false
local function probeKey(key)
	local results, found, soft, pending = {}, nil, nil, #CANDIDATES
	for i, cnd in ipairs(CANDIDATES) do
		task.spawn(function()
			local p = { url = cnd.url, model = cnd.model, key = key, kind = cnd.kind }
			local ok, reply, err = pcall(callProvider, p, { { role = "user", content = "Reply with: ok" } }, "Reply with one short word.")
			if ok and reply then
				results[i] = "ok"
				if not found then found = i end
			else
				local e
				if ok then e = tostring(err) else e = tostring(reply) end
				results[i] = e
				local l = e:lower()
				if not soft and l:find("model", 1, true) and (l:find("not found", 1, true)
					or l:find("does not exist", 1, true) or l:find("unknown", 1, true) or l:find("invalid", 1, true)) then
					soft = i
				end
			end
			pending -= 1
		end)
	end
	local t0 = os.clock()
	while not found and pending > 0 and os.clock() - t0 < 25 do task.wait(0.1) end
	local idx = found or soft
	return idx and CANDIDATES[idx], results, (found == nil and idx ~= nil)
end

